{
  "name": "soundcloud-desktop",
  "version": "1.1.0",
  "description": "Schlanke SoundCloud-Desktop-App (Electron) für Linux und Windows",
  "main": "main.js",
  "homepage": "https://github.com/jesajaw/soundcloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/jesajaw/soundcloud.git"
  },
  "author": {
    "name": "jesajaw",
    "email": "JesajaWeintritt@outlook.de"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "relay": "node jam/relay.js",
    "test": "node --test",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.soundcloud.desktop",
    "productName": "SoundCloud Desktop",
    "files": ["main.js", "preload.js", "package.json", "icon.png", "lib/**", "jam/**"],
    "protocols": [{ "name": "SoundCloud Jam", "schemes": ["scjam"] }],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "icon": "icon.png",
      "maintainer": "jesajaw <JesajaWeintritt@outlook.de>",
      "synopsis": "SoundCloud-Desktop-App"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.png"
    }
  }
}
