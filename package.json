{
  "name": "soundcloud-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Minimal SoundCloud desktop app (Electron) for Linux and Windows",
  "main": "main.js",
  "homepage": "https://github.com/jesajaw/soundcloud",
  "repository": { "type": "git", "url": "git+https://github.com/jesajaw/soundcloud.git" },
  "author": "jesajaw",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "electron . --quit-on-close",
    "dev": "electron . --dev --quit-on-close",
    "relay": "node jam/relay.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.soundcloud.desktop",
    "productName": "SoundCloud Desktop",
    "files": ["main.js", "preload.js", "package.json", "icon.png", "jam/**"],
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo", "icon": "icon.png", "maintainer": "jesajaw <jesajaw@users.noreply.github.com>", "synopsis": "SoundCloud desktop app" },
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" }
  }
}
