{
  "name": "soundcloud-desktop",
  "version": "1.0.0",
  "description": "Schlanke SoundCloud-Desktop-App (Electron) für Linux und Windows",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.soundcloud.desktop",
    "productName": "SoundCloud Desktop",
    "files": ["main.js", "package.json", "icon.png"],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "icon": "icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.png"
    }
  }
}
